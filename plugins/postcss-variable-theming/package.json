{
  "name": "postcss-variable-theming",
  "version": "0.4.0",
  "description": "PostCSS plugin to provide theming function based on CSS variables using @var rules.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spring-raining/postcss-plugins.git",
    "directory": "plugins/postcss-variable-theming"
  },
  "author": "spring-raining <harusamex.com@gmail.com>",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w --preserveWatchOutput",
    "try": "postcss --config ./postcss.config.js",
    "test": "node --test ./test/index.js"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "typescript": "^7.0.2"
  }
}
